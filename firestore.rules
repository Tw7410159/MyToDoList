// firestore.rules
// Firestore 安全規則 — MyToDoList
// 請將此檔案部署到 Firebase Console 或使用 Firebase CLI 部署

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 使用者個人資料 ──────────────────────────────
    match /users/{userId} {
      // 任何登入用戶可讀取（協作者需要查詢頭像等資訊）
      allow read:  if request.auth != null;
      // 只能寫入自己的文件
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 待辦清單 ───────────────────────────────────
    match /lists/{listId} {
      // 只有成員才能讀取
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      // 建立：登入後可建立，且必須把自己加入 memberUids
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid == request.resource.data.ownerId;

      // 更新：只有成員可更新
      // （加入清單時，對方透過邀請碼把自己加入 memberUids，也算允許）
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);

      // 刪除：只有擁有者可刪除
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;

      // ── 待辦事項子集合 ──
      match /todos/{todoId} {
        // 清單成員才能讀寫
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids;
      }
    }

    // ── 邀請記錄（Email 邀請用）────────────────────
    match /invites/{inviteId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
